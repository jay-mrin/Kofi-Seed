# Frontend public config
# Copy src/config.example.js to src/config.js and fill the public values there too.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PROJECT_REF=your-project-ref

# Server-only Supabase secrets for Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayPal server secrets for Edge Functions.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_CURRENCY=USD

# Separate PayPal Business account used when SuperAdmin routing is selected.
SUPER_ADMIN_PAYPAL_CLIENT_ID=your-superadmin-paypal-client-id
SUPER_ADMIN_PAYPAL_CLIENT_SECRET=your-superadmin-paypal-client-secret
SUPER_ADMIN_PAYPAL_WEBHOOK_ID=your-superadmin-paypal-webhook-id


# Public site origin allowed by Edge Functions CORS.
SITE_ORIGIN=http://127.0.0.1:5173
