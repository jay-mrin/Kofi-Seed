# Frontend public config
# Copy src/config.example.js to src/config.js and fill the public values there too.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PROJECT_REF=your-project-ref

# Server-only Supabase secrets for Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin-owned Dodo Payments checkout. Create a one-time USD product in Dodo,
# enable Pay What You Want with a $7 minimum, then add its product id here.
DODO_PAYMENTS_ENV=test_mode
DODO_PAYMENTS_CURRENCY=USD
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_PRODUCT_ID=pdt_your-product-id
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your-webhook-signing-secret
# Optional when SITE_ORIGIN already points to the public homepage.
DODO_RETURN_URL=https://your-site.example/

# SuperAdmin PayPal server secrets for new checkouts.
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
SUPER_ADMIN_PAYPAL_CLIENT_ID=your-superadmin-paypal-client-id
SUPER_ADMIN_PAYPAL_CLIENT_SECRET=your-superadmin-paypal-client-secret
SUPER_ADMIN_PAYPAL_WEBHOOK_ID=your-superadmin-paypal-webhook-id

# Optional legacy Admin credentials: keep them while older Admin payments or
# subscriptions still require capture, confirmation, or webhook verification.
PAYPAL_CLIENT_ID=your-legacy-admin-paypal-client-id
PAYPAL_CLIENT_SECRET=your-legacy-admin-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-legacy-admin-paypal-webhook-id

# Public site origin allowed by Edge Functions CORS.
SITE_ORIGIN=http://127.0.0.1:5173
